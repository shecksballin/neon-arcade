{
  "name": "@neon/server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neon/types": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/sdk": "^1.0.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.8.2"
  }
}
