# Neon PostgreSQL connection string
DATABASE_URL=

# Signs the session JWTs minted after wallet sign-in (any random string
# ≥32 chars, e.g. `openssl rand -hex 32`). Injected by Doppler at
# runtime — do NOT paste a real value here. Auth routes answer 503
# until it exists.
JWT_SECRET=

# Encrypts TOTP authenticator secrets at rest (AES-256-GCM) so a
# database leak alone can't clone 2FA codes. Exactly 64 hex chars
# (`openssl rand -hex 32`). Injected by Doppler at runtime — do NOT
# paste a real value here. Profile routes answer 503 until it exists.
TOTP_ENC_KEY=

# Exact frontend origin for CORS (never "*"). Defaults in code to the
# local Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# OpenRouter API key for AI trivia generation.
# Injected by Doppler at runtime (`doppler run`) — do NOT paste a real key here.
# config/env.ts reads this exact name from process.env and requires it to start
# with "sk-or-". Listed here only to document the secret name.
OPENROUTER_API_KEY=

# Model slug used to generate questions. Optional — defaults in code to the free
# tier (poolside/laguna-s-2.1:free). Set only to override.
QUIZ_MODEL=poolside/laguna-s-2.1:free

# Optional OpenRouter ranking headers (non-secret).
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Neon Arcade

# Google Gemini API key
GEMINI_API_KEY=
