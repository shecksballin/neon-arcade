VITE_API_URL=http://localhost:3002
VITE_WS_URL=http://localhost:3002

# Public (not secret) 25-char app id from dashboard.privy.io.
# Locally it's injected from Doppler by `doppler run -- turbo dev`
# (VITE_* vars must also be listed in turbo.json globalPassThroughEnv,
# or turbo's strict env mode strips them before Vite sees them).
VITE_PRIVY_APP_ID=
