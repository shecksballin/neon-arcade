# ─────────────────────────────────────────────
# NEON ARCADE — Environment Variables Reference
# Copy structure into Doppler. Never commit real values.
# ─────────────────────────────────────────────

# ── Database (Neon) ──
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Redis (Railway) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=
# AES-256-GCM key sealing TOTP authenticator secrets at rest
# (exactly 64 hex chars — `openssl rand -hex 32`)
TOTP_ENC_KEY=

# ── Privy (auth + embedded wallets) ──
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Public 25-char app id, exposed to the Vite frontend (same value as
# PRIVY_APP_ID; the VITE_ prefix is what lets Vite ship it to the browser)
VITE_PRIVY_APP_ID=

# ── Solana ──
SOLANA_RPC_URL=https://api.devnet.solana.com
HOUSE_WALLET_ADDRESS=
HOUSE_WALLET_PRIVATE_KEY=
COLD_WALLET_ADDRESS=

# ── OpenRouter (AI trivia generation) ──
# REQUIRED, but injected by Doppler at runtime — do NOT put a real key here or
# in any committed file. `doppler run` provides it as process.env at boot
# (must start with "sk-or-"). Listed here only so you know the secret name.
OPENROUTER_API_KEY=
# Model slug used to generate questions. Defaults to the free tier in code
# (poolside/laguna-s-2.1:free); set here only to override.
QUIZ_MODEL=poolside/laguna-s-2.1:free
# Optional OpenRouter ranking headers (non-secret).
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Neon Arcade

# ── Server ──
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── Wager economics ──
HOUSE_FEE_PERCENT=25  # of earnings
MIN_BET_SOL=0.01
MAX_BET_SOL=10

# ── Vercel Blob (3D asset storage, if used) ──
BLOB_READ_WRITE_TOKEN=
